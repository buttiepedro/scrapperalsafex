# Endpoint de import de la base de conocimiento
ALSAFEX_KNOWLEDGE_ENDPOINT=https://crm2-alsafex.plataformabit.com/knowledge/import
ALSAFEX_KNOWLEDGE_TOKEN=bitautomatizacion

# Página a scrapear
ALSAFEX_URL=https://alsafex.com.ar/descargas

# Poner en false para solo generar el JSON sin enviarlo
ALSAFEX_UPLOAD=true

# Si se extraen menos documentos que esto, se aborta sin subir
ALSAFEX_MIN_DOCUMENTS=40

ALSAFEX_TIMEOUT=30
ALSAFEX_MAX_RETRIES=3
